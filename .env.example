# Humers Infratech Environment Configuration Template
NODE_ENV=production
PORT=3000

# Secret key for session encryption (generate a strong random string in production)
SESSION_SECRET=humers_infratech_production_secure_key_change_in_prod

# Cookie security: set to true if domain uses HTTPS/SSL
COOKIE_SECURE=false

# Maximum upload file size in Megabytes
UPLOAD_MAX_MB=50

# Custom Storage Directories (Optional, defaults to ./data and ./uploads)
# DATA_DIR=/path/to/data
# UPLOADS_DIR=/path/to/uploads

# Initial Default Admin Credentials (Used on initial database seed only)
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123
